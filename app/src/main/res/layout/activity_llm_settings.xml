<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="#1E1E1E"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="←"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/llm_settings_title"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingStart="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Category: Engine & Mode -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/llm_settings_category_engine"
                android:textColor="#4CAF50"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <Switch
                android:id="@+id/switchUseLocalLlm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/llm_settings_use_local"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/llm_settings_use_local_summary"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/llm_settings_context_window"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <Spinner
                android:id="@+id/spinnerContextWindow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#222222"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvTemperatureLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/llm_settings_temperature_default"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <SeekBar
                android:id="@+id/seekBarTemperature"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="14"
                android:progress="6"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/llm_settings_system_prompt"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/editSystemPrompt"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:gravity="top|start"
                android:background="#222222"
                android:textColor="#FFFFFF"
                android:padding="10dp"
                android:hint="@string/llm_settings_system_prompt_hint"
                android:textColorHint="#666666"
                android:textSize="14sp"
                android:layout_marginBottom="24dp"/>

            <!-- Category: Cloud Settings -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/llm_settings_category_cloud"
                android:textColor="#2196F3"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/editLlmBaseUrl"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#222222"
                android:textColor="#FFFFFF"
                android:padding="10dp"
                android:hint="@string/settings_llm_base_url"
                android:textColorHint="#666666"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/editLlmModel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#222222"
                android:textColor="#FFFFFF"
                android:padding="10dp"
                android:hint="@string/settings_llm_model"
                android:textColorHint="#666666"
                android:textSize="14sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/editLlmKey"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#222222"
                android:textColor="#FFFFFF"
                android:padding="10dp"
                android:hint="@string/settings_llm_key"
                android:textColorHint="#666666"
                android:textSize="14sp"
                android:layout_marginBottom="24dp"/>

            <!-- Category: Appearance & Customization -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/llm_settings_category_appearance"
                android:textColor="#FF9800"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/llm_settings_theme"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <Spinner
                android:id="@+id/spinnerThemePreset"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#222222"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/llm_settings_wallpaper"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvWallpaperStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/llm_settings_wallpaper_none"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnPickWallpaper"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="@string/llm_settings_wallpaper_pick"
                    android:textSize="12sp"
                    android:backgroundTint="#333333"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btnClearWallpaper"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="✕"
                    android:textSize="14sp"
                    android:backgroundTint="#D32F2F"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvDimmingLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/llm_settings_dimming_default"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <SeekBar
                android:id="@+id/seekBarDimming"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="90"
                android:progress="50"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/llm_settings_font_style"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <Spinner
                android:id="@+id/spinnerFontStyle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#222222"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/llm_settings_font_size"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                android:layout_marginBottom="6dp"/>

            <Spinner
                android:id="@+id/spinnerFontSize"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#222222"
                android:layout_marginBottom="24dp"/>

            <!-- Category: Language -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_lang"
                android:textColor="#AB47BC"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <Spinner
                android:id="@+id/spinnerLlmLang"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#222222"
                android:layout_marginBottom="24dp"/>

            <!-- Chat Actions -->
            <Button
                android:id="@+id/btnClearChat"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/llm_settings_clear_chat"
                android:textSize="14sp"
                android:backgroundTint="#424242"
                android:textColor="#FF5252"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/settings_save"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="24dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
