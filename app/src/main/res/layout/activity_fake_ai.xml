<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAiLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <!-- Custom Wallpaper & Dimming Overlay -->
    <ImageView
        android:id="@+id/ivWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/viewWallpaperOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/headerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/llm_header_title"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="⚙"
                android:textSize="18sp"
                android:textColor="#CCCCCC"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="0dp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvRamInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/llm_ram_checking"
            android:textColor="#4CAF50"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/modelLoaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#222222"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/topBarLayout">
        
        <TextView
            android:id="@+id/modelStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/llm_no_model"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"/>

        <TextView
            android:id="@+id/tvCtxLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/llm_ctx_label"
            android:textColor="#888888"
            android:textSize="12sp"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="2dp"/>

        <Spinner
            android:id="@+id/spinnerContextWindow"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"/>
            
        <Button
            android:id="@+id/btnLoadModel"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/llm_btn_load_gguf"
            android:textSize="12sp"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/modelLoaderLayout"
        app:layout_constraintBottom_toTopOf="@id/bottomContainer"
        android:padding="16dp">
        
        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            
            <TextView
                android:id="@+id/tvWelcomeMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/llm_welcome_msg"
                android:textColor="#00FF00"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/attachmentPreviewLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#2A2A2A"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvAttachmentName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFCA28"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:ellipsize="middle"
                android:singleLine="true"/>

            <Button
                android:id="@+id/btnRemoveAttachment"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="✕"
                android:textSize="12sp"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:padding="0dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/inputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                android:id="@+id/btnAttachFile"
                android:layout_width="44dp"
                android:layout_height="50dp"
                android:text="📎"
                android:textSize="18sp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:padding="0dp"/>

            <Button
                android:id="@+id/btnInternetSearch"
                android:layout_width="48dp"
                android:layout_height="50dp"
                android:text="🌐"
                android:textSize="18sp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#333333"
                android:textColor="#888888"
                android:padding="0dp"/>

            <EditText
                android:id="@+id/aiInput"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:background="#333333"
                android:textColor="#FFFFFF"
                android:hint="@string/llm_prompt_hint"
                android:textColorHint="#888888"
                android:padding="12dp"
                android:imeOptions="flagNoPersonalizedLearning"
                android:privateImeOptions="nm"
                android:inputType="textMultiLine|textNoSuggestions"/>

            <Button
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:text="@string/llm_btn_send"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
