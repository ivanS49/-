{
  "manifest_version": 2,
  "name": "WebRTC Shield",
  "version": "1.0",
  "permissions": [
    "<all_urls>",
    "webRequest",
    "webRequestBlocking",
    "privacy",
    "storage",
    "nativeMessaging"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "background": {
    "scripts": ["background.js"]
  }
}